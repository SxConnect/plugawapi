FROM golang:1.26 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o plugawapi ./cmd/server

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/plugawapi /usr/local/bin/plugawapi
# Sem -static: apenas API, sem frontend
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/plugawapi"]
CMD ["-addr", ":8080", "-db", "/data/plugawapi.db"]
